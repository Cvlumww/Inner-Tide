# Public canonical frontend URL
NEXT_PUBLIC_SITE_URL=https://inner-tide.studio

# Server-only WordPress REST base; do not use a NEXT_PUBLIC_ prefix
WORDPRESS_API_URL=https://cms.inner-tide.studio/wp-json/wp/v2

# Must match INNER_TIDE_REVALIDATE_SECRET in WordPress wp-config.php
REVALIDATE_SECRET=replace-with-a-long-random-value

# Existing contact form integration
RESEND_API_KEY=

